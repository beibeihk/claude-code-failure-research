{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preregistered reliability scenario",
  "type": "object",
  "required": ["id", "title", "scenario_version", "claude_code_version", "surface", "model", "platform", "fixture", "task", "constraints", "treatment", "control", "success_criteria", "failure_criteria", "repetitions", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "scenario_version": {"type": "string"},
    "claude_code_version": {"type": "string"},
    "surface": {"type": "string"},
    "model": {"type": "string"},
    "platform": {"type": "string"},
    "fixture": {"type": "string"},
    "task": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "treatment": {"type": "string"},
    "control": {"type": "string"},
    "success_criteria": {"type": "array", "items": {"type": "string"}},
    "failure_criteria": {"type": ["object", "array"]},
    "repetitions": {"type": "integer", "minimum": 1},
    "status": {"type": "string"}
  }
}
